[Unit]
Description=xoxod33p store Next.js Application
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/xoxod33p-store
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=4000

[Install]
WantedBy=multi-user.target
