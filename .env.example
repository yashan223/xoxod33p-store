# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# MongoDB (used by docker compose and the app driver)
MONGODB_URI=mongodb://xoxod33p_admin:change-me-local@127.0.0.1:27017/xoxod33p-store?authSource=admin
MONGODB_DB=xoxod33p-store
MONGO_ROOT_USERNAME=xoxod33p_admin
MONGO_ROOT_PASSWORD=change-me-local
MONGO_PORT=27017

# Admin authorization
ADMIN_USER_IDS=
ADMIN_EMAILS=
ADMIN_DEFAULT_EMAIL=admin@xoxod33p.store
ADMIN_DEFAULT_PASSWORD=change-me-local

# Payments.lk
PAYMENTS_LK_SECRET_KEY=sk_test_replace_me
PAYMENTS_LK_WEBHOOK_SECRET=whsec_replace_me
PAYMENTS_LK_SUCCESS_PATH=/checkout/success
PAYMENTS_LK_CANCEL_PATH=/?cart=1

# Resend (transactional email for verification and password resets)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

